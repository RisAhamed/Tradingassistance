# =============================================================================
# Trading Agent — environment / SECRETS template.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only SECRETS and machine-specific connection strings belong here.
# All non-secret operational configuration belongs in configs/config.yaml.
# =============================================================================

# --- Application ---
APP_ENV=development
# Path to the central configuration file (relative to the repo root or absolute).
CONFIG_PATH=configs/config.yaml
# Overrides trading.mode from config.yaml (only "paper" is accepted at runtime).
TRADING_MODE=paper

# --- Alpaca (PAPER ONLY) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Must remain true. The engine refuses to start against live endpoints.
ALPACA_PAPER=true
# crypto | iex | sip  (feed selection for the data provider)
ALPACA_DATA_FEED=crypto

# --- Market-data MODE (Phase C1) ---
# Unset => offline/test defaults (history provider "none", mock-friendly).
# Set these to run the REAL-DATA configuration (Alpaca historical warm-up +
# live 1-minute bar stream). These are switches, not secrets.
# MARKET_DATA_PROVIDER=alpaca
# MARKET_DATA_HISTORY_PROVIDER=alpaca

# --- Ollama (AI supervisor, optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=

# --- Persistence ---
# Leave empty to default to a local SQLite file under ./data/.
# Example PostgreSQL URL: postgresql+asyncpg://user:pass@localhost:5432/trading_agent
DATABASE_URL=

# --- Optional enrichment sources (skipped when absent) ---
QUIVER_API_KEY=
