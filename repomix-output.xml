def safety_preflight(env, config) -> dict[str, Any]:
    checks = {
        "trading_mode_paper": config.trading.mode == "paper",
        "repo_execution_enabled_is_false": config.execution.enabled is False,
        "env_alpaca_paper": bool(env.alpaca_paper),
