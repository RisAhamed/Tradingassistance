  <script>
    const $ = (id) => document.getElementById(id);
    const show = (id, v) => { $(id).textContent = typeof v === "string" ? v : JSON.stringify(v, null, 2); };
    async function get(path) {
      const res = await fetch(path);
      if (!res.ok) throw new Error(path + " -> " + res.status);
      return res.json();
    }
    async function refresh() {
      try {
        const [health, system, market, mdata, warm, handoff, loggingState, exec, ready, features, regime, strategy, risk, positions, pnl, orders, session, ai, decision, freshnessState, lifecycle] =
          await Promise.all([
            get("/health"), get("/api/system/status"), get("/api/market/latest"), get("/api/market/status"),
            get("/api/warmup"), get("/api/handoff"), get("/api/logging"), get("/api/execution"), get("/api/readiness"),
            get("/api/features"), get("/api/regime"), get("/api/strategy/status"), get("/api/risk/status"), get("/api/positions"),
            get("/api/pnl"), get("/api/orders"), get("/api/session"), get("/api/ai/status"), get("/api/decision"),
            get("/api/freshness"), get("/api/trade-plan/lifecycle"),
          ]);
        $("health").textContent = "health: " + health.status + (health.ready ? " (ready)" : " (not ready)");
        $("health").className = "banner " + (health.status === "healthy" ? "ok" : health.status === "warning" ? "warn" : "err");

        // PHASE B: make EXECUTION_DISABLED impossible to miss.
        const ex = (execution || {}).execution || {};
        const execBanner = $("execution");
        if (ex.enabled) {
          execBanner.textContent = "EXECUTION: ENABLED";
          execBanner.className = "banner err";
        } else {
          execBanner.textContent = "EXECUTION: DISABLED — no orders will be sent";
          execBanner.className = "banner err";
          document.title = "Trading Agent — EXECUTION DISABLED (Phase B)";
        }

        const md = mdata || {};
        $("conn").textContent = "feed: " + (md.provider || "…") + " " +
          (md.connected ? "connected" : "disconnected") + " · " + (md.data_status || "…") +
          (md.symbol ? " · " + md.symbol : "");
        $("conn").className = "banner " + (md.data_status === "LIVE" ? "ok" : "warn");

        show("system", system); show("mdata", md); show("warm", warm); show("handoff", handoff); show("candles", handoff.candles || {}); show("recovery", handoff.recovery || {}); show("logging", loggingState); show("exec", exec); show("ready", ready); show("market", market);
        show("features", features); show("regime", regime);
        show("strategy", strategy); show("risk", risk); show("position", positions);
        show("pnl", pnl); show("orders", orders); show("sess", session); show("ai", ai);
        // Phase D
        show("freshness", decision.freshness_policy);
        show("freshness-state", freshnessState);
        show("timeframes", decision.timeframe_selection);
        show("tradeplan", decision.trade_plan);
        show("tradeplan-lifecycle", lifecycle);
        show("decision-trace", decision.decision_trace || []);
        $("session").textContent = "session: " + (((session || {}).session || {}).state || "…");
      } catch (err) { $("health").textContent = "health: api unavailable (" + err.message + ")"; }
    }
    async function expRefresh() {
      try {
        const exp = await get("/api/experiment/status");
        $("exp-state").textContent = "experiment: " + exp.state + (exp.execution_enabled ? " (EXECUTION ON)" : " (execution off)");
        $("exp-state").className = "banner " + (exp.state === "running" || exp.state === "armed" ? "warn" : exp.state === "halted" || exp.state === "failed" ? "err" : "");
        $("exp-countdown").textContent = exp.seconds_remaining == null ? "" : ("window remaining: " + Math.round(exp.seconds_remaining) + "s");
        show("exp-envelope", exp.envelope || "no envelope — authorize to freeze one");
      } catch (err) { $("exp-state").textContent = "experiment: api unavailable"; }
    }
    document.querySelectorAll("button[data-exp]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.getAttribute("data-exp");
        const box = $("exp-msg");
        try {
          let res;
          if (action === "authorize") {
            const operator = $("exp-operator").value.trim();
            const window_minutes = parseInt($("exp-minutes").value, 10);
            if (!operator || !(window_minutes >= 5)) { box.textContent = "operator name + window minutes (5-240) required"; return; }
            if (!confirm("Authorize paper execution inside the frozen envelope? This enables REAL paper orders.")) return;
            res = await fetch("/api/experiment/authorize", { method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({ operator, window_minutes }) });
          } else if (action === "arm") {
            if (!confirm("Arm execution now? Orders may be submitted inside the authorized window.")) return;
            res = await fetch("/api/experiment/arm", { method: "POST" });
          } else if (action === "halt") {
            res = await fetch("/api/experiment/halt", { method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({ reason: "operator_halt", operator: "human" }) });
          }
          box.textContent = action + ": " + res.status + " " + (await res.text()).slice(0, 300);
          await expRefresh(); await refresh();
        } catch (err) { box.textContent = action + " failed: " + err.message; }
      });
    });
    expRefresh(); setInterval(expRefresh, 2000);
    document.querySelectorAll("button[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.getAttribute("data-action");
        $("ctl-msg").textContent = action + "…";
        try {
          const res = await fetch("/api/control/" + action, { method: "POST" });
          $("ctl-msg").textContent = action + ": " + res.status + " " + (await res.text()).slice(0, 200);
          await refresh();
        } catch (err) { $("ctl-msg").textContent = action + " failed: " + err.message; }
      });
    });
    function stream() {
      const es = new EventSource("/api/stream");
      es.onmessage = (ev) => {
        const el = document.createElement("div");
        el.textContent = ev.data.slice(0, 300);
        const box = $("stream");
        box.prepend(el);
        while (box.children.length > 25) box.lastChild.remove();
      };
      es.onerror = () => { $("stream").textContent = "stream disconnected — polling every 2s"; es.close(); setTimeout(stream, 5000); };
    }
    refresh(); setInterval(refresh, 2000); stream();
  </script>
</body>
